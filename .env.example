# ============================================
# MokaTest 平台 - 服务器部署环境变量
# ============================================
# 复制本文件为 .env 后按需修改，docker compose 会自动读取

# ---- 前端对外端口（默认 80，如与其他服务冲突可在 .env 中覆盖）----
HOST_HTTP_PORT=80

# ---- 后端对外端口 ----
BACKEND_PORT=7529

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=mokatest123
MYSQL_DATABASE=mokatest
# 如需从宿主机连接 MySQL，可修改映射端口；不需要外访时请删除 docker-compose.yml 中的 ports 映射
MYSQL_PORT=3306

# ---- Spring Boot 数据源（通常与上面 MySQL 配置保持一致）----
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/mokatest?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=mokatest123

# ---- 文件存储（MinIO） ----
# 可选值：local / minio / cos / oss
STORAGE_TYPE=minio

# MinIO API 地址（Docker 内部网络使用服务名 minio；外部独立部署时填写实际地址）
STORAGE_MINIO_ENDPOINT=http://minio:9000

# MinIO 存储桶名，需要与 minio-init 中的 MINIO_BUCKET 保持一致
STORAGE_MINIO_BUCKET=mokatest

# MinIO 控制台账号密码，生产环境务必修改
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MinIO API 和控制台对外映射端口
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_BUCKET=mokatest

# 是否通过后端代理访问文件（true 不跨域，false 直接访问 MinIO 直链/签名 URL）
STORAGE_MINIO_USE_PROXY=true

# ---- 初始化数据 ----
# 留空：仅初始化表结构和 RBAC 默认账号
# 如需加载演示/初始化数据，设置为 SQL 文件相对路径，如 ./backEnd/sql/your_demo_data.sql
QA_INIT_SQL=
